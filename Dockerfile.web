FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Root .env supplies VITE_* tint vars (baked at build). Missing file is fine.
RUN if [ -f .env ]; then echo "Using .env for Vite build"; else echo "No .env — Vite defaults"; fi \
  && npm run build

FROM nginx:1.27-alpine

# Default: HTTP bootstrap. Swap to nginx.docker.conf after SSL certs exist.
ARG NGINX_CONF=nginx.http.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY nginx.docker.conf /etc/nginx/templates/nginx.ssl.conf
COPY --from=build /app/build /usr/share/nginx/html

RUN mkdir -p /var/www/certbot

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
