# The production site calls the same-origin /api path through Nginx.
# Vite proxies /api to http://127.0.0.1:3001 in local development.

# Warna tint aset nature (multiply dengan tekstur atlas). Build-time: butuh restart dev/rebuild.
# Default "#ffffff" = pakai tekstur asli (tidak ada perubahan). Format hex: #rrggbb
# PENTING: selalu bungkus dengan tanda kutip karena "#" dianggap komentar di .env.
VITE_COLOR_TREE="#ffffff"
VITE_COLOR_BUSH="#ffffff"
VITE_COLOR_GRASS="#ffffff"
VITE_COLOR_ANIMAL="#ffffff"

# Warna dasar gradien tanah (sisi kiri-kanan). Kosong = gradien pink default.
# Misal "#ffeb3b" = gradien kuning, "#a3c98f" = gradien hijau.
VITE_COLOR_GROUND=""

# === Tint per-jenis aset nature (VITE_TINT_*). Override warna per file GLB. ===
# Nama var = VITE_TINT_ + basename (tanpa .glb) uppercase, non-alnum -> _.
# Contoh: tree_1_a_color1.glb -> VITE_TINT_TREE_1_A_COLOR1
# #ffffff = warna atlas asli (identity). Restart dev/build setelah ubah.
# Karena aset pakai satu material atlas, tint berlaku seragam ke daun + batang.
# VITE_COLOR_* (kategori, di atas) jadi fallback bila var per-jenis tidak di-set.

# --- POHON ---
VITE_TINT_TREE_HIGH="#ffffff"   # tree-high.glb
VITE_TINT_TREE="#ffffff"       # tree.glb
VITE_TINT_TREE_1_A_COLOR1="#ffffff"  # tree_1_a_color1.glb
VITE_TINT_TREE_2_A_COLOR1="#ffffff"  # tree_2_a_color1.glb
VITE_TINT_TREE_3_A_COLOR1="#ffffff"  # tree_3_a_color1.glb
VITE_TINT_TREE_4_A_COLOR1="#ffffff"  # tree_4_a_color1.glb

# --- SEMAK ---
VITE_TINT_BUSH_1_A_COLOR1="#ffffff"  # bush_1_a_color1.glb
VITE_TINT_BUSH_4_D_COLOR1="#ffffff"  # bush_4_d_color1.glb

# --- RUMPUT / BUNGA ---
VITE_TINT_GRASS_1_A_COLOR1="#ffffff"  # grass_1_a_color1.glb
VITE_TINT_GRASS_2_A_COLOR1="#ffffff"  # grass_2_a_color1.glb

# --- HEWAN ---
VITE_TINT_ANIMAL_BUNNY="#ffffff"  # animal-bunny.glb

# --- LAMPU ---
VITE_TINT_STREET_LIGHT="#ffffff"  # street_light.glb
