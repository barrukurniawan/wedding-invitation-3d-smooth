PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=wedding
DB_PASSWORD=replace_with_database_password
DB_NAME=wedding_db
SESSION_TTL_HOURS=12
USER_SESSION_TTL_HOURS=168
COOKIE_SECURE=false
BASE_DOMAIN=marryme.web.id
ROOT_ORIGIN=http://localhost:5173
WEB_PORT=5173
# Set only when requests come through a trusted reverse proxy (for Docker: 1).
TRUST_PROXY=
# DEPRECATED: no longer used. Root hosts never resolve a public tenant.
# Local invitation API/3D: use http://{slug}.localhost:5173/ (e.g. kia-toni.localhost).
# LOCAL_TENANT_SLUG=kia-toni

# === Google OAuth (root dashboard login) ===
# Redirect URI must match Google Cloud Console exactly, e.g.
# https://marryme.web.id/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# === Dashboard admin (login /admin) ===
# Username & password awal untuk login dashboard admin.
# Syarat: password minimum 12 karakter. Jangan pakai placeholder di production.
# Cara menerapkan perubahan: jalankan `npm run seed-admin` dari folder server/,
# lalu restart API (`npm run dev`). Password disimpan sebagai hash bcrypt di
# tabel admin_users; nilai di sini hanya dipakai saat seeding.
# Ganti password lewat menu dashboard setelah login untuk production.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_a_long_unique_password

# === Midtrans Payment Gateway ===
# Daftar di https://dashboard.midtrans.com — ambil Server Key & Client Key
# Untuk sandbox (testing): prefix SB-Mid-server-... dan SB-Mid-client-...
# Untuk production: prefix Mid-server-... dan Mid-client-...
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY

