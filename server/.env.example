PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=wedding
DB_PASSWORD=replace_with_database_password
DB_NAME=wedding_db
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# === Dashboard admin (login /admin) ===
# Username & password awal untuk login dashboard admin.
# Syarat: password minimum 12 karakter. Jangan pakai placeholder di production.
# Cara menerapkan perubahan: jalankan `npm run seed-admin` dari folder server/,
# lalu restart API (`npm run dev`). Password disimpan sebagai hash bcrypt di
# tabel admin_users; nilai di sini hanya dipakai saat seeding.
# Ganti password lewat menu dashboard setelah login untuk production.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_a_long_unique_password
