PORT=3001
NODE_ENV=production
DB_HOST=db
DB_PORT=3306
DB_USER=wedding
DB_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__
DB_NAME=wedding_db
SESSION_TTL_HOURS=12
USER_SESSION_TTL_HOURS=168
COOKIE_SECURE=true
# PAYMENT_MODE: manual (transfer + bukti) | tako (bayar online via tako.id, butuh INVITATION_PRICE_IDR > 0) | midtrans
PAYMENT_MODE=manual
# Tako (tako.id/me/api-keys). Callback URL: https://marryme.web.id/api/payment/tako/callback
# Redirect URL: https://marryme.web.id/account?bayar=tako. Kosong = pembayaran Tako mati.
TAKO_USERNAME=marryme
TAKO_API_KEY=
TAKO_CALLBACK_SECRET=
INVITATION_PRICE_IDR=0
BASE_DOMAIN=marryme.web.id
ROOT_ORIGIN=https://marryme.web.id
TRUST_PROXY=1
GOOGLE_CLIENT_ID=__REPLACE_WITH_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REPLACE_WITH_GOOGLE_CLIENT_SECRET__
GOOGLE_REDIRECT_URI=https://marryme.web.id/api/auth/google/callback
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS__

# Promo peluncuran untuk landing page (semua opsional; promo tampil hanya jika
# PRICE_NORMAL_IDR > INVITATION_PRICE_IDR dan PROMO_ENDS_AT belum lewat).
PRICE_NORMAL_IDR=299999
PRICE_AFTER_PROMO_IDR=49999
PROMO_LABEL=Promo Launching
PROMO_ENDS_AT=2026-10-14T23:59:59+07:00
WHATSAPP_NUMBER=6282122126254

# CDN aset desain (jsDelivr). Kosong = nonaktif (semua dari server sendiri).
# Diisi dengan keluaran `npm run assets:publish`, mis.:
# ASSET_CDN_BASE=https://cdn.jsdelivr.net/gh/barrukurniawan/marryme-assets@v2026.10.11-1
ASSET_CDN_BASE=
